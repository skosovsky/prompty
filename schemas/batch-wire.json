{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompty.invalid/batch-wire",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "provider", "endpoint", "account_binding", "provider_id", "status", "items"],
  "properties": {
    "format": {"const": "prompty.batch"},
    "provider": {"type": "string", "minLength": 1},
    "endpoint": {"type": "string", "minLength": 1},
    "account_binding": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["queued", "in_progress", "canceling", "ended", "failed", "expired", "canceled", "unknown"]},
    "provider_status": {"type": "string", "minLength": 1},
    "resources": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["kind", "provider_id"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "provider_id": {"type": "string", "minLength": 1}}
    }},
    "items": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "original_id", "attempt_id", "identity", "execution_digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "original_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "parent_attempt_id": {"type": "string", "minLength": 1},
        "identity": {"$ref": "https://prompty.invalid/wire-common#/$defs/identity"},
        "execution_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }}
  }
}
