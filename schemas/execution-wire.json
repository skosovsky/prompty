{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompty.invalid/execution-wire",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "messages",
    "metadata"
  ],
  "properties": {
    "format": {
      "const": "prompty.execution.v2"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "developer",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "https://prompty.invalid/wire-common#/$defs/part"
            }
          },
          "provider_state": {
            "type": "array",
            "items": {
              "$ref": "https://prompty.invalid/wire-common#/$defs/state"
            }
          },
          "annotations": {
            "type": "array",
            "items": {
              "$ref": "https://prompty.invalid/wire-common#/$defs/annotation"
            }
          },
          "message_annotations": {
            "type": "array",
            "items": {
              "$ref": "https://prompty.invalid/wire-common#/$defs/message_annotation"
            }
          },
          "continuation_unavailable": {
            "type": "boolean"
          },
          "cache_policy": {
            "$ref": "https://prompty.invalid/wire-common#/$defs/cache"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "manifest_id": {
                "type": "string"
              },
              "layer_id": {
                "type": "string"
              }
            }
          },
          "metadata": true,
          "layer_kind": {
            "type": "string"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "dialect": {
            "type": "string"
          },
          "parameters": true,
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "required_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forced_tool": {
      "type": "string"
    },
    "model_options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "temperature": {
          "type": "number"
        },
        "max_tokens": {
          "type": "integer"
        },
        "top_p": {
          "type": "number"
        },
        "stop": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extras": true
      }
    },
    "cache_resource": {
      "$ref": "https://prompty.invalid/cache-resource-wire"
    },
    "request_cache": {
      "allOf": [
        {
          "$ref": "https://prompty.invalid/wire-common#/$defs/cache"
        },
        {
          "properties": {
            "mechanism": {
              "const": "implicit_prefix"
            }
          }
        }
      ]
    },
    "response_format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "dialect": {
          "type": "string"
        },
        "schema": true
      }
    },
    "provider": true,
    "requirements": {
      "$ref": "https://prompty.invalid/wire-common#/$defs/requirements"
    },
    "tool_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "required"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "dialect": {
                "type": "string"
              },
              "parameters": true,
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "dialect": {
                "type": "string"
              },
              "parameters": true,
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
