{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompty.dev/schemas/manifest-descriptor.json",
  "title": "Captured source identity",
  "type": "object",
  "required": [
    "id",
    "digest"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^:/\\\\]+(?:/[^:/\\\\]+)*$",
      "allOf": [
        {
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          }
        },
        {
          "not": {
            "pattern": "(^|/)[^/]*\\.[^/]*$"
          }
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^source-bundle\\.v1:sha256:[0-9a-f]{64}$"
    }
  }
}
